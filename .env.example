# Polymarket Insider Tracker - Environment Configuration
# Copy this to .env and fill in your values

# ==================== SERVER ====================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ==================== DATABASE ====================
# SQLite is used by default (file-based)
# For production with high volume, consider PostgreSQL
DATABASE_TYPE=sqlite
DATABASE_PATH=./polymarket_tracker.db

# ==================== TELEGRAM BOT ====================
# Get your bot token from https://t.me/BotFather
# Example: 123456789:ABCDefghijklmnopqrstuvwxyz
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==================== POLYMARKET API ====================
# Optional: Get from https://docs.polymarket.com/api
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_URL=https://api.polymarket.com

# ==================== BLOCKCHAIN RPC ====================
# Optional: For fetching on-chain transaction data
RPC_ENDPOINT=https://rpc.mainnet.com
RPC_API_KEY=your_rpc_key_here

# ==================== MONITORING ====================
# Detection interval in milliseconds (5000 = 5 seconds)
MONITORING_INTERVAL=5000

# Enable/disable detection types
DETECT_FRESH_WALLETS=true
DETECT_BEHAVIORAL_SHIFTS=true
DETECT_WHALE_CLUSTERS=true

# ==================== ALERTS ====================
# Alert confidence thresholds
FRESH_WALLET_THRESHOLD=65
BEHAVIOR_SHIFT_THRESHOLD=75

# Telegram alert tiers
# FREE tier: 30-second delay
# PRO tier: Instant alerts
TELEGRAM_FREE_DELAY_MS=30000
TELEGRAM_PRO_DELAY_MS=0

# ==================== SECURITY ====================
API_KEY=your_secret_api_key_for_rest_endpoints
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==================== PERFORMANCE ====================
# Database batch insert size
BATCH_INSERT_SIZE=50

# Data retention (days)
DATA_RETENTION_DAYS=90

# Maximum wallets to track per cycle
MAX_WALLETS_PER_CYCLE=1000

# ==================== DEVELOPMENT ====================
DEBUG=false
VERBOSE_LOGGING=true
